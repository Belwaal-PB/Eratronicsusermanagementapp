{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/data"
    },
    {
      "source": "/((?!api/|static/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
