{
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "functions": {
    "api/data.php": {
      "runtime": "php@1.0.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/data.php"
    },
    {
      "source": "/((?!static/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
